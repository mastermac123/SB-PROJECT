# All optional. The app runs fully without any of these.

# Google sign-in restricted to the vitstudent.ac.in Workspace domain.
VITE_GOOGLE_CLIENT_ID=

# OSRM-compatible routing server (defaults to the public OSRM demo server).
VITE_OSRM_URL=

# Shown in the SOS sheet only when set. Verify the number with campus security first.
VITE_CAMPUS_SECURITY_PHONE=
