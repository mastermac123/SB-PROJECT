{
  "name": "ridesync-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RideSync AI — AI-matched carpooling for the VIT community",
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --open",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "prestart": "node scripts/check-node.mjs",
    "start": "node --import tsx server/prod.ts",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "express": "^5.2.1",
    "framer-motion": "^14.0.0",
    "google-auth-library": "^11.2.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.53.0",
    "nodemailer": "^10.0.16",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
